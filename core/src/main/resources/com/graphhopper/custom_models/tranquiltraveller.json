{
  "distance_influence": 20,
  "priority": [
    { "if": "!car_access || rsbikeaccess == NO || road_class == CONSTRUCTION || road_type_i1 == PATH", "multiply_by": "0" },
    { "if": "road_access == PRIVATE", "multiply_by": "0.2" },

    { "if": "oneway == YES", "do": [
      { "if": "lanes > 1", "multiply_by": "0.8" },
      { "else": "", "multiply_by": "0.9" }
    ] },
    { "else": "", "do": [
      { "if": "lanes > 1", "multiply_by": "0.9" },
      { "else": "", "multiply_by": "1" }
    ] },

    { "if": "road_setting_i1 == URBAN", "multiply_by": "0.7" },
    { "else_if": "road_type_i1 == MDR", "multiply_by": "1" },
    { "else_if": "road_type_i1 == SH",  "multiply_by": "0.95" },
    { "else_if": "road_type_i1 == OH",  "multiply_by": "0.8" },
    { "else_if": "road_type_i1 == NH",  "multiply_by": "0.7" },
    { "else": "", "multiply_by": "0.7" }

  ],
  "speed": [
    { "if": "true", "limit_to": "120" },
    { "if": "surface==COBBLESTONE || surface==GRASS || surface==GRAVEL || surface==SAND || surface==PAVING_STONES || surface==DIRT || surface==GROUND || surface==UNPAVED || surface==COMPACTED", "limit_to": "30" },

    { "if": "oneway == YES", "do": [
      { "if": "lanes > 1", "multiply_by": "1" },
      { "else": "", "multiply_by": "0.9" }
    ] },
    { "else": "", "do": [
      { "if": "lanes > 1", "multiply_by": "0.9" },
      { "else": "", "multiply_by": "0.8" }
    ] },

    { "if": "road_setting_i1 == RURAL", "do": [
      { "if": "road_type_i1 == NH", "multiply_by": "0.9" },
      { "else_if": "road_type_i1 == SH", "multiply_by": "0.8" },
      { "else_if": "road_type_i1 == MDR", "multiply_by": "0.7" },
      { "else_if": "road_type_i1 == OH", "multiply_by": "0.5" },
      { "else_if": "road_type_i1 == HADJ", "multiply_by": "0.5" },
      { "else_if": "road_type_i1 == TRACK", "multiply_by": "0.2" },
      { "else_if": "road_type_i1 == WOH", "multiply_by": "0.25" },
      { "else": "", "multiply_by": "0.25" }
    ] },
    { "else_if": "road_setting_i1 == SEMIURBAN", "do": [
      { "if": "road_type_i1 == NH", "multiply_by": "0.8" },
      { "else_if": "road_type_i1 == SH", "multiply_by": "0.6" },
      { "else_if": "road_type_i1 == MDR", "multiply_by": "0.6" },
      { "else_if": "road_type_i1 == OH", "multiply_by": "0.4" },
      { "else_if": "road_type_i1 == HADJ", "multiply_by": "0.5" },
      { "else_if": "road_type_i1 == TRACK", "multiply_by": "0.2" },
      { "else_if": "road_type_i1 == WOH", "multiply_by": "0.25" },
      { "else": "", "multiply_by": "0.25" }
    ] },
    { "else_if": "road_setting_i1 == URBAN", "do": [
      { "if": "road_type_i1 == NH", "multiply_by": "0.6" },
      { "else_if": "road_type_i1 == SH", "multiply_by": "0.5" },
      { "else_if": "road_type_i1 == MDR", "multiply_by": "0.5" },
      { "else_if": "road_type_i1 == OH", "multiply_by": "0.4" },
      { "else_if": "road_type_i1 == HADJ", "multiply_by": "0.5" },
      { "else_if": "road_type_i1 == TRACK", "multiply_by": "0.2" },
      { "else_if": "road_type_i1 == WOH", "multiply_by": "0.4" },
      { "else": "", "multiply_by": "0.25" }
    ] },
    { "else": "", "multiply_by": "0.25" },

    { "if": "intersection_speed_degradation_final < 1.0", "multiply_by": "intersection_speed_degradation_final" },

    { "if": "build_perc >= 50", "multiply_by": "0.5" },
    { "else_if": "build_perc >= 35", "multiply_by": "0.6" },
    { "else_if": "build_perc >= 25", "multiply_by": "0.7" },
    { "else_if": "build_perc >= 15", "multiply_by": "0.8" },
    { "else": "", "multiply_by": "1" },

    { "if": "population_density < 1000", "multiply_by": "1" },
    { "else_if": "population_density >= 1000 && population_density < 2500", "multiply_by": "0.9" },
    { "else_if": "population_density >= 2500 && population_density < 5000", "multiply_by": "0.8" },
    { "else_if": "population_density >= 5000 && population_density < 20000", "multiply_by": "0.6" },
    { "else_if": "population_density >= 20000 && population_density < 40000", "multiply_by": "0.5" },
    { "else_if": "population_density >= 40000 && population_density < 100000", "multiply_by": "0.4" },
    { "else_if": "population_density >= 100000 && population_density < 200000", "multiply_by": "0.3" },
    { "else": "", "multiply_by": "0.2" },

    { "if": "curvature <= 0.60", "multiply_by": "0.6" },
    { "else_if": "curvature <= 0.90", "multiply_by": "curvature" },
    { "else": "", "multiply_by": "1" }
  ]
}
